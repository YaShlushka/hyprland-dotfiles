{
	"layer": "top",
	"position": "top",
	"margin-top" : 5,
   "margin-left": 10,
   "margin-right": 10,
	"height" : 30,
	// "spacing": 10,

	"modules-left": [
		"group/left"
	],

   "modules-center": [
		"group/center"
   ],

   "modules-right": [
		"group/right"
	],

	"group/left": {
		"orientation": "horizontal",
		"modules": [
			"tray",
			"custom/separator",
			"wlr/taskbar",
			"custom/separator",
			"clock"
		]
	},

	"group/center": {
		"orientation": "horizontal",
		"modules": [
			"hyprland/language",
			"custom/separator",
			"hyprland/workspaces",
			"custom/separator",
			"custom/notifications"
		]
	},

	"group/right": {
		"orientation": "horizontal",
		"modules": [
			"group/system_info",
			"custom/separator",
	    	"group/power_menu"
		]
	},


	"group/system_info": {
		"orientation": "horizontal",
		"modules": [
			"memory",
			"cpu"
		]
	},

	"group/power_menu": {
		"orientation": "horizontal",
		"modules": [
			"network",
			"custom/off_button"
		]
	},

	"tray": {
		"icon-size": 18,
		"rotate": 0,
		"spacing": 5
	},

	"hyprland/workspaces": {
		"rotate": 0,
		"all-outputs": true,
		"active-only": false,
		"format": "{icon}",
		"on-click": "activate",
		"disable-scroll": false,
		"on-scroll-up": "hyprctl dispatch workspace +1",
		"on-scroll-down": "hyprctl dispatch workspace -1",
		"persistent-workspaces": {},
		"format-icons": {
			"1": "一",
			"2": "二",
			"3": "三",
			"4": "四",
			"5": "五",
			"6": "六",
			"7": "七",
			"8": "八",
			"9": "九",
			"10": "十"
		}
    },

	 "wlr/taskbar": {
		"format": "{icon}",
		"rotate": 0,
		"icon-size": 18,
		"icon-theme": "Tela-circle-dracula",
        "spacing": 0,
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"app_ids-mapping": {
			"firefoxdeveloperedition": "firefox-developer-edition"
		}
	},
	
   "clock": {
      // "format": "  {:%H:%M %p}",
		"format": " {:%H:%M}",
		"rotate": 0,
		"format-alt": "{:%R | 󰃭 %d·%m·%y}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b>{}</b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-click-forward": "tz_up",
			"on-click-backward": "tz_down",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},

	"memory": {
		"interval": 1,
      "format": " {used:0.1f}G/{total:0.1f}G ",
      "tooltip-format": "RAM: {used} used out of {total}"
   },

   "cpu": {
		"format": " {usage}%",
      "tooltip": false
   },

	"pulseaudio": {
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}%  {format_source}",
      "format-bluetooth-muted": "{icon}   {format_source}",
      "format-muted": " ",
      "format-icons": {
         "headphone": "",
         "hands-free": "",
         "headset": "",
         "phone": "",
         "portable": "",
         "car": "",
         "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
   },

	"hyprland/language": {
		"format": "{}",
		"format-en": "英語",
		"format-ru": "ロシア語",
		"rotate": 0,
		"min-length": 2,
		"tooltip": false
	},

   "network": {
      "format-wifi": "  ",
      "format-ethernet": "{cidr}  ",
      "tooltip-format": "{ifname} via {gwaddr}  ",
      "format-linked": "{ifname} (No IP)  ",
      "format-disconnected": "⚠ "
   },

	"custom/off_button": {
		"format": "⏻ ",
		"interval": "once",
		"tooltip": false,
		"on-click": "~/.config/rofi/applets/bin/powermenu.sh"
	},

	"custom/separator": {
		"format": "|",
  	   "interval": "once",
      "tooltip": false
	},

	"custom/notifications": {
		"exec": "/home/paderinee/.config/hypr/scripts/get_swaync_icon.sh",
		"interval": 1,
		"on-click": "swaync-client -t",
		"on-click-right": "swaync-client -d -sw",
		"format": "{} ",
		"tooltip": false
	}
}
